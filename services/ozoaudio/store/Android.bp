cc_library_shared {
    name: "libozoc2store",
    defaults: ["libcodec2-ozo-defaults"],
    vendor: true,

    srcs: [
        "OzoC2Store.cpp",
    ],

    include_dirs: [
        "frameworks/av/media/libozoaudio/include"
    ],

    shared_libs: [
        "android.hardware.graphics.bufferqueue@2.0",
    ],

    sanitize: {
        misc_undefined: [
            "unsigned-integer-overflow",
            "signed-integer-overflow",
        ],
        cfi: true,
    },

    ldflags: ["-Wl,-Bsymbolic"],
}
