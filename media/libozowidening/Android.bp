    name: "libozowidening",
    vendor: true,

    compile_multilib: "both",

    multilib: {
        lib64: {
            srcs: ["shared_lib/armv8-a/Release/libozowidening.so"],
        },
        lib32: {
            srcs: ["shared_lib/armv7-a/Release/libozowidening.so"],
        },
    },

    strip: {
        none: true,
        keep_symbols: true,
    },
}
