// OZO Audio effects processing library
cc_library_shared {
    name: "libeffectozowidening",

    vendor: true,
    srcs: [
        "widening.cpp"
    ],

    cflags: [
        "-O2",
        "-fvisibility=hidden",
        "-Wall",
        "-Werror",
    ],

    include_dirs: [
        "system/media/audio_utils/include",
        "frameworks/av/media/libozowidening/include",
        "frameworks/av/media/libozoaudio/include"
    ],

    shared_libs: [
        "libozowidening",
        "libcutils",
        "libutils",
        "libaudioutils",
        "liblog"
    ],

    relative_install_path: "soundfx",

    header_libs: ["libaudioeffects"],
}
