// OZO Audio effects processing library
cc_library_shared {
    name: "libozoprocessing",

    vendor: true,
    srcs: [
        "ozo.cpp"
    ],

    cflags: [
        "-O2",
        "-fvisibility=hidden",
        "-Wall",
        "-Werror",
    ],

    include_dirs: [
        "system/media/audio_utils/include",
        "frameworks/av/media/libstagefright/include",
        "frameworks/av/media/libozoaudio",
        "frameworks/av/media/libozoaudio/include"
    ],

    shared_libs: [
        "libcutils",
        "libav_ozoencoder",
        "libutils",
        "libaudioutils",
        "liblog"
    ],

    relative_install_path: "soundfx",

    header_libs: ["libaudioeffects"],
}
