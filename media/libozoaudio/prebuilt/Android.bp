cc_prebuilt_library_shared {
    name: "libozoaudio",
    vendor: true,

    compile_multilib: "both",

    multilib: {
        lib64: {
            srcs: ["armv8-a/Release/libozoaudio.so"],
        },
        lib32: {
            srcs: ["armv7-a/Release/libozoaudio.so"],
        },
    },

    required: [
        "libozoaudio",
    ],

    strip: {
        none: true,
        keep_symbols: true,
    }
}

cc_prebuilt_library_shared {
    name: "libozoaudio_systemext",
    system_ext_specific: true,

    compile_multilib: "both",

    multilib: {
        lib64: {
            srcs: ["armv8-a/Release/libozoaudio.so"],
        },
        lib32: {
            srcs: ["armv7-a/Release/libozoaudio.so"],
        },
    },

    required: [
        "libozoaudio_system",
    ],

    strip: {
        none: true,
        keep_symbols: true,
    }
}

cc_prebuilt_library_shared {
    name: "libozoaudioutils",
    system_ext_specific: true,

    compile_multilib: "both",

    multilib: {
        lib64: {
            srcs: ["armv8-a/Release/libozoaudioutils.so"],
        },
        lib32: {
            srcs: ["armv7-a/Release/libozoaudioutils.so"],
        },
    },

    required: [
        "libozoaudioutils",
    ],

    strip: {
        none: true,
        keep_symbols: true,
    }
}
