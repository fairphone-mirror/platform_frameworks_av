cc_library_shared {
    name: "libav_ozoencoder",
    vendor: true,

    srcs: [
        "aac_enc.cpp",
        "ozo_wrapper.cpp",
        "event_emitter.cpp",
        "parameters.cpp",
    ],

    include_dirs: [
        "frameworks/av/media/libozoaudio/include",
        "frameworks/native/include/media/openmax",
        "system/media/audio/include/system",
        "external/aac/libAACenc/include",
        "external/aac/libSYS/include",
        "external/speex/include",
    ],

    static_libs: ["libFraunhoferAAC"],

    shared_libs: [
        "libozoaudio",
        "liblog",
        "libutils",
        "libbinder",
        "libspeexresampler",
    ]
}
